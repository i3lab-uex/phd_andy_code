        name="Experiment 5 - coronacases_005">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
