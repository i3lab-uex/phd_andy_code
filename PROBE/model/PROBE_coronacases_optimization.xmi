<?xml version="1.0" encoding="UTF-8"?>
<PROBE:PROBE
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:PROBE="https://www.example.org/PROBE"
    xsi:schemaLocation="https://www.example.org/PROBE ../metamodel/PROBE.ecore">
  <dataset name="Coronacases"
      description="Lung CT (Coronacases Dataset)">
    <subset
        name="trainingSet"
        path="datasets/covid"
        dataFolderName="COVID-19-CT-Seg_20cases"
        labelsFolderName="Lung_Mask">
      <sample
          filename="coronacases_001.nii.gz"/>
      <sample
          filename="coronacases_002.nii.gz"/>
      <sample
          filename="coronacases_003.nii.gz"/>
      <sample
          filename="coronacases_004.nii.gz"/>
      <sample
          filename="coronacases_005.nii.gz"/>
      <sample
          filename="coronacases_006.nii.gz"/>
      <sample
          filename="coronacases_007.nii.gz"/>
      <sample
          filename="coronacases_008.nii.gz"/>
      <sample
          filename="coronacases_009.nii.gz"/>
      <sample
          filename="coronacases_010.nii.gz"/>
    </subset>
  </dataset>
  <optimization_task
      name="Genetic Algorithms"
      description="Tarea de optimización mediante el uso de algoritmos genéticos">
    <performance_metric
        name="Jaccard Index"
        baseline="0.9738"/>
    <performance_metric
        name="Dice Coefficient"
        type="DICE"
        baseline="0.9866"/>
    <performance_metric
        name="SAM Score"
        type="SAM_SCORE"/>
    <foundation_model
        name="vit_h"
        version="1.0"
        description="SAM ViT-H"
        checkpointFilepath="model_checkpoints/sam_vit_h_4b8939.pth"
        configuration=""/>
    <optimization_metric
        name="Sam Score as an optimization metric"
        type="SAM_SCORE"/>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.0"
        name="Experiment 1 - coronacases_001">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:NoImprovement"/>
      <stop_condition
          xsi:type="PROBE:TimeLimit"
          minutesDuration="5.0"/>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.1"
        name="Experiment 2 - coronacases_002">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.2"
        name="Experiment 3 - coronacases_003">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.3"
        name="Experiment 4 - coronacases_004">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
