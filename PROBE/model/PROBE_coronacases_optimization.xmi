        name="Experiment 6 - coronacases_006">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.6"
        name="Experiment 7 - coronacases_007">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.7"
        name="Experiment 8 - coronacases_008">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.8"
        name="Experiment 9 - coronacases_009">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.9"
        name="Experiment 10 - coronacases_010">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
  </optimization_task>
  <optimization_task
      name="Swarm Algorithms"
      description="Tarea de optimización mediante el uso de algoritmos de enjambres (SWARM)"
      algorithm="PARTICLE_SWARM">
    <performance_metric
        name="Jaccard Index"
        baseline="0.9738"/>
    <performance_metric
        name="Dice Coefficient"
        type="DICE"
        baseline="0.9866"/>
    <performance_metric
        name="SAM Score"
        type="SAM_SCORE"/>
    <foundation_model
        name="vit_b"
        version="1.0"
        description="MedSAM ViT-B"
        checkpointFilepath="model_checkpoints/medsam_vit_b_01ec64.pth"
        configuration=""/>
    <optimization_metric
        name="Sam Score as an optimization metric"
        type="SAM_SCORE"/>
    <experiment
        sample="//@dataset.0/@subset.0/@sample.0"
        name="Experiment 1 - coronacases_001">
      <initial_state
          description="Experiment 1 Initial State">
        <prompt
            xsi:type="PROBE:PromptForImage">
          <point/>
          <point/>
          <point
              type="NEGATIVE"/>
          <bounding_box/>
        </prompt>
      </initial_state>
      <stop_condition
          xsi:type="PROBE:NoImprovement"/>
      <stop_condition
          xsi:type="PROBE:TimeLimit"
          minutesDuration="5.0"/>
      <stop_condition
          xsi:type="PROBE:MaxIterations"
          numIterations="1000"/>
    </experiment>
  </optimization_task>
</PROBE:PROBE>
