# Generated instance model for ProbeMM
import os
from python_application.static_code.probe_interface import ProbeInterface
    [for (e : EEnum | aPROBE.eClass().ePackage.eClassifiers->filter(ecore::EEnum))]
from python_application.generated_code.enumerations.[e.name/] import [e.name/]
    [/for]
    [for (c : EClass | aPROBE.eClass().ePackage.eClassifiers->filter(ecore::EClass))]
from python_application.generated_code.model.[c.name/] import [c.name/]
    [/for]

# Processing device
processing_device = DeviceType.[aPROBE.device/]

# Build datasets
datasets = ['['/]
    [for (d : Dataset | aPROBE.dataset) separator(',\n')]
    Dataset(
        name="[d.name/]",
        description="[d.description/]",
        type=DataType.[d.type/],
        subset=['['/]
        [for (subset : Subset | d.subset) separator(',\n')]
            Subset(
                name="[subset.name/]",
                path=os.path.join(os.getcwd(), "[subset.path/]"),
                dataFolderName="[subset.dataFolderName/]",
                labelsFolderName="[subset.labelsFolderName/]",
                sample=['['/]
                [for (sample : Sample | subset.sample) separator(',\n')]
                    Sample(
                        filename="[sample.filename/]",
                        extension=FileFormatType.[sample.extension/]
                    )[/for]
                [']'/]
            )[/for]
        [']'/]
    )[/for]
[']'/]

# Build optimization tasks
optimization_task = ['['/]
[for (ot : OptimizationTask | aPROBE.optimization_task) separator(',\n')]
    OptimizationTask(
        name="[ot.name/]",
        description="[ot.description/]",
        algorithm=OptimizationAlgorithm.[ot.algorithm/],
        foundation_model=FoundationModel(
            name="[ot.foundation_model.name/]",
            version=[ot.foundation_model.version/],
            description="[ot.foundation_model.description/]",
            checkpointFilepath=os.path.join(os.getcwd(), "[ot.foundation_model.checkpointFilepath/]"),
            configuration="[ot.foundation_model.configuration/]",
            type=ModelType.[ot.foundation_model.type/]
        ),
        experiment=['['/]
    [for (exp : Experiment | ot.experiment) separator(',\n')]
		[let initial_state : State = exp.initial_state.oclAsType(State)]
            Experiment(
                name="[exp.name/]",
                initial_state=State(
                    description="[initial_state.description/]",
                    hasImproved=[if (initial_state.hasImproved)]True[else]False[/if],
                    prompt=[if (initial_state.prompt.oclIsTypeOf(PromptForImage))]PromptForImage(
                        bounding_box=[if (initial_state.prompt.oclAsType(PromptForImage).bounding_box)<>null]['['/][for (bb : BoundingBox | initial_state.prompt.oclAsType(PromptForImage).bounding_box.oclAsType(BoundingBox)) separator(', ')]BoundingBox(min_coordinates=Coordinates(x=[bb.min_coordinates.x/], y=[bb.min_coordinates.y/]), max_coordinates=Coordinates(x=[bb.max_coordinates.x/], y=[bb.max_coordinates.y/]))[/for][']'/][else]None[/if],
                        point=[if (initial_state.prompt.oclAsType(PromptForImage).point)<>null]['['/][for (p : Point | initial_state.prompt.oclAsType(PromptForImage).point.oclAsType(Point)) separator(', ')]Point(type=PointType.[p.type/], coordinates=Coordinates(x=[p.coordinates.x/], y=[p.coordinates.y/]))[/for][']'/][else]None[/if]
                    )
                    [elseif (exp.initial_state.prompt.oclIsTypeOf(PromptForText))]PromptForText()
                    [elseif (exp.initial_state.prompt.oclIsTypeOf(PromptForAudio))]PromptForAudio()
                    [else]None[/if]
                ),
                stop_condition=['['/][for (sc : StopCondition | exp.stop_condition) separator(', ')][if (sc.oclIsTypeOf(TimeLimit))]TimeLimit(minutesDuration=[sc.oclAsType(TimeLimit).minutesDuration/])[elseif (sc.oclIsTypeOf(MaxIterations))]MaxIterations(numIterations=[sc.oclAsType(MaxIterations).numIterations/])[elseif (sc.oclIsTypeOf(NoImprovement))]NoImprovement()[else]None[/if][/for][']'/],
                sample=Sample(
                    filename="[exp.sample.filename/]",
                    extension=FileFormatType.[exp.sample.extension/]
                )
            )
		[/let]
    [/for]
        [']'/],
        optimization_metric=Metric(name="[ot.optimization_metric.name/]", type=MetricType.[ot.optimization_metric.type/]),
        performance_metric=['['/]
    [for (metric : Metric | ot.performance_metric) separator(',\n')]
            Metric(name="[metric.name/]", type=MetricType.[metric.type/],
   )[/for]
    [']'/]
    )
[/for]
[']'/]

# Build the PROBE instance
probe = PROBE(
    device=processing_device,
    dataset=datasets,
    optimization_task=optimization_task
)


if __name__ == "__main__":
    
    # Print the starting message
    print("🚀 Starting PROBE - SAM Optimization Interface...")
    print("📝 Press Ctrl+C to exit")

    # Create and launch the interface
    interface = ProbeInterface(probe)
    interface.launch()

