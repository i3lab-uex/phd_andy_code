            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xD;&#xA;    def run_optimization_whole_task(self, task_name: str, population_size: int = 100,&#xD;&#xA;                                    seed: int = 1) -> Dict"/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="[">
